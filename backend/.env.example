APP_NAME=Binexa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bunnybin
DB_USERNAME=bunnybin
DB_PASSWORD=

MQTT_HOST=mosquitto
MQTT_PORT=1883
# Broker tidak lagi anonim (docker/mosquitto/mosquitto.conf). Akun ini punya
# akses BACA saja ke binexa/# — backend memang tidak pernah mem-publish ke
# topik device. Kredensial device terpisah, dikunci per-unit lewat ACL.
MQTT_AUTH_USERNAME=binexa-backend
MQTT_AUTH_PASSWORD=
# Dipakai `artisan simulate:devices` saja — akun ini boleh menulis ke SELURUH
# binexa/#, jadi JANGAN pernah ada di broker produksi.
MQTT_SIMULATOR_USERNAME=binexa-simulator
MQTT_SIMULATOR_PASSWORD=
CV_SERVICE_URL=http://cv-service:8000
# Shared secret ke CV service — HARUS sama dengan CV_INTERNAL_TOKEN di
# cv-service-fastapi/.env. Layanan CV menolak start bila kosong, dan
# menolak /classify (401) bila header X-Internal-Token tidak cocok.
CV_INTERNAL_TOKEN=
SANCTUM_STATEFUL_DOMAINS=admin.binexa.local,localhost:5173
# Masa berlaku token Sanctum dalam MENIT. 259200 = 180 hari.
# Token kiosk dulu berlaku selamanya; sejak ada provisioning runtime
# (POST /devices/activate) kedaluwarsa tidak lagi berarti rebuild bundle —
# perangkat mengambil token barunya lewat kode aktivasi.
SANCTUM_TOKEN_EXPIRATION=259200

FRONTEND_URL=http://localhost:5173
# WAJIB diisi — db:seed akan gagal bila kosong. Tidak ada password default:
# email super admin (admin@binexa.id) sudah pasti, jadi password yang bisa
# ditebak berarti akun itu bisa diambil alih dalam satu percobaan.
SEED_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.binexa.local

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
