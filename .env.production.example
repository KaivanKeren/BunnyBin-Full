# Environment PRODUKSI Binexa — templat untuk docker-compose.prod.yml.
#
#   cp .env.production.example .env    # lalu isi SEMUA nilai bertanda WAJIB
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Berkas hasil salinannya (.env di root) GITIGNORED. Satu berkas dipakai dua
# peran: interpolasi variabel compose DAN env_file untuk container backend.

# ── Aplikasi ──────────────────────────────────────────────────────────────────
APP_NAME=Binexa
APP_ENV=production
# WAJIB. Generate: docker compose -f docker-compose.prod.yml run --rm backend php artisan key:generate --show
APP_KEY=
# JANGAN pernah true di produksi: halaman error Laravel menampilkan seluruh
# konfigurasi, termasuk kredensial database.
APP_DEBUG=false
APP_URL=https://admin.binexa.example

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ── Host (dipakai nginx untuk membedakan dua frontend) ────────────────────────
ADMIN_HOST=admin.binexa.example
KIOSK_HOST=kiosk.binexa.example
HTTP_PORT=80

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=binexa
DB_USERNAME=binexa
# WAJIB. Generate: openssl rand -base64 32
DB_PASSWORD=

# ── Broker MQTT ───────────────────────────────────────────────────────────────
# Akun subscriber mqtt:listen — akses BACA saja ke binexa/#.
# Kredensialnya dibuat dengan mosquitto_passwd; lihat docker/mosquitto/passwd.example.
MQTT_PORT=1883
MQTT_AUTH_USERNAME=binexa-backend
# WAJIB
MQTT_AUTH_PASSWORD=

# Simulator TIDAK BOLEH ada di produksi: akunnya boleh menulis ke SELURUH
# binexa/#, yaitu kewenangan yang justru dicabut dari penyerang. Biarkan kosong,
# dan jangan buat entri `binexa-simulator` di passwd produksi.
MQTT_SIMULATOR_USERNAME=
MQTT_SIMULATOR_PASSWORD=

# ── CV service ────────────────────────────────────────────────────────────────
CV_MODE=real
CV_MODEL_PATH=/model/best.pt
# WAJIB. Harus SAMA di kedua sisi. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CV_INTERNAL_TOKEN=
# Hanya bila CV_MODE=roboflow
ROBOFLOW_MODEL_ID=
ROBOFLOW_API_KEY=

# ── Sesi & token ──────────────────────────────────────────────────────────────
# HARUS berisi host dashboard admin. JANGAN masukkan host kiosk: kiosk memakai
# token Bearer, dan mendaftarkannya sebagai stateful memberlakukan CSRF pada
# request kiosk sehingga semua POST ditolak 419 sementara GET tetap lolos —
# gejalanya kiosk tampak tersambung tapi tidak ada data yang tersimpan.
SANCTUM_STATEFUL_DOMAINS=admin.binexa.example
FRONTEND_URL=https://admin.binexa.example
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.binexa.example
# Masa berlaku token kiosk dalam MENIT (259200 = 180 hari). Perangkat mengambil
# token barunya lewat kode aktivasi, jadi kedaluwarsa tidak menuntut rebuild.
SANCTUM_TOKEN_EXPIRATION=259200

# ── Queue & cache ─────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Seeder ────────────────────────────────────────────────────────────────────
# WAJIB bila menjalankan db:seed — tidak ada password default. Email super admin
# sudah pasti (admin@binexa.id), jadi password yang bisa ditebak berarti akun itu
# bisa diambil alih dalam satu percobaan.
SEED_ADMIN_PASSWORD=

# ── Build frontend ────────────────────────────────────────────────────────────
# Di-inline saat BUILD image, bukan dibaca saat runtime — mengubahnya menuntut
# `--build` ulang. Path relatif karena nginx melayani API di host yang sama.
ADMIN_API_URL=/api
KIOSK_API_URL=/api
