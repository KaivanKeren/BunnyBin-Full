# WAJIB diisi — layanan menolak berjalan tanpa autentikasi.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Salin nilai yang sama ke CV_INTERNAL_TOKEN di backend/.env.
CV_INTERNAL_TOKEN=

CV_MODE=dummy
CV_CONFIDENCE_THRESHOLD=0.6
CV_MAX_IMAGE_MB=5
# real mode (lihat training/README.md):
#   Docker  : CV_MODEL_PATH=/model/best.pt  (mount models/ -> /model)
#   Host demo: CV_MODEL_PATH=models/best-demo.pt  (python training/make_demo_model.py)
CV_MODEL_PATH=/model/best.pt
# roboflow mode (cloud API):
# ROBOFLOW_MODEL_ID=your-workspace/your-model/3
# ROBOFLOW_API_KEY=your-api-key
#
# vlm / gemini mode — klasifikasi lewat model bahasa-visual, dengan bobot di
# CV_MODEL_PATH sebagai cadangan otomatis saat API tak terjangkau. VLM_TIMEOUT_S
# berlaku untuk keduanya dan harus lebih kecil dari timeout Laravel (30 dtk).
#
# CV_MODE=vlm (Claude):
# ANTHROPIC_API_KEY=sk-ant-...
# VLM_MODEL=claude-haiku-4-5
#
# CV_MODE=gemini (Google AI Studio, ada free tier tanpa kartu kredit):
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash   <- verifikasi di aistudio.google.com
#
# VLM_TIMEOUT_S=12
