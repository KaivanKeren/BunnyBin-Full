# WAJIB diisi — layanan menolak berjalan tanpa autentikasi.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Salin nilai yang sama ke CV_INTERNAL_TOKEN di backend/.env.
CV_INTERNAL_TOKEN=

CV_MODE=dummy
CV_CONFIDENCE_THRESHOLD=0.6
CV_MAX_IMAGE_MB=5
# real mode (lihat training/README.md):
#   Docker  : CV_MODEL_PATH=/model/best.pt  (mount models/ -> /model)
#   Host demo: CV_MODEL_PATH=models/best-demo.pt  (python training/make_demo_model.py)
CV_MODEL_PATH=/model/best.pt

# ── Perekam frame lapangan ────────────────────────────────────────────────────
# KOSONG = mati (bawaan). Menyimpan gambar anak-anak harus keputusan sadar.
#
# Saat diisi, tiap frame yang diklasifikasi disimpan bersama sidecar .json berisi
# tebakan model. Ini bahan baku set evaluasi LAPANGAN — satu-satunya cara
# mengetahui akurasi sebenarnya, karena metrik training diukur pada split dari
# dataset publik yang sama dengan train split-nya.
#
#   CV_CAPTURE_DIR=training/field_eval   # kumpulkan
#   python training/eval_field.py training/field_eval   # ukur (setelah dilabeli)
#
# Nyalakan saat sesi pengumpulan data, matikan sesudahnya.
CV_CAPTURE_DIR=

# roboflow mode (cloud API):
# CATATAN: model `deteksi-sampah-organik-anorganik/3` mengeluarkan nama kelas
# "Sampah Organik"/"Sampah Anorganik" — itu KATEGORI, bukan nama benda. Kiosk
# akan menampilkan "Sampah Anorganik" untuk sebuah botol, dan tak ada benda
# spesifik yang bisa dicocokkan ke soal kuis. Pakai hanya bila itu memang cukup.
# ROBOFLOW_MODEL_ID=your-workspace/your-model/3
# ROBOFLOW_API_KEY=your-api-key
#
# vlm / gemini mode — klasifikasi lewat model bahasa-visual, dengan bobot di
# CV_MODEL_PATH sebagai cadangan otomatis saat API tak terjangkau. VLM_TIMEOUT_S
# berlaku untuk keduanya dan harus lebih kecil dari timeout Laravel (30 dtk).
#
# CV_MODE=vlm (Claude):
# ANTHROPIC_API_KEY=sk-ant-...
# VLM_MODEL=claude-haiku-4-5
#
# CV_MODE=gemini (Google AI Studio, ada free tier tanpa kartu kredit):
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash   <- verifikasi di aistudio.google.com
#
# CV_MODE=openai — SATU mode untuk semua penyedia berprotokol /chat/completions.
# Ganti penyedia = ganti dua nilai, tanpa menyentuh kode.
#
#   Groq — REKOMENDASI free tier (per Agu 2026): 30 permintaan/menit dan
#   14.400/hari, vs Gemini 10/menit dan 1.500/hari. Modelnya open-weight
#   (Qwen). Kunci gratis tanpa kartu kredit: console.groq.com
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_API_KEY=gsk_...
#     OPENAI_MODEL=qwen/qwen3.6-27b   <- verifikasi di console.groq.com/docs/models
#
#   Ollama — lokal, open-source penuh, TANPA kuota. Realistis hanya dengan GPU:
#   di CPU/iGPU, VLM terkecil pun makan 5-20 dtk/frame — melewati jendela
#   pindai kiosk (15 dtk).
#     OPENAI_BASE_URL=http://localhost:11434/v1
#     OPENAI_MODEL=qwen3-vl           <- API key tidak diperlukan
#
#   OpenRouter — :free hanya 50 permintaan/hari tanpa deposit; cukup untuk uji
#   coba, tidak untuk kiosk.
#
# OPENAI_JSON_MODE=schema   <- "off" bila server menolak response_format dengan
#                              400 (gejalanya: SEMUA panggilan tiba-tiba
#                              dilayani model cadangan)
#
# VLM_TIMEOUT_S=12

# ── Pengendalian biaya & kuota (berlaku untuk vlm & gemini) ───────────────────
# Free tier Gemini: 10 permintaan/menit, 1500/hari.
#
# Loop pindai kiosk memanggil tiap 2 dtk dan, pada latensi nyata ~2,6 dtk,
# menghasilkan ~13 panggilan/menit — SATU kiosk saja sudah melewati batas itu,
# sebelum menghitung anak kedua. Dua setelan di bawah yang membuat angka itu
# masuk akal; tanpa keduanya, kelebihannya dibayar sebagai 429 beruntun dan
# kiosk diam-diam berjalan penuh di model cadangan.
#
# VLM_MAX_RPM — rem di sisi kita, disetel di bawah batas penyedia. Kelebihan
# permintaan dilayani model lokal dan DITANDAI degraded, bukan ditolak penyedia.
# Naikkan bila billing aktif; 0 mematikan rem sepenuhnya.
VLM_MAX_RPM=10
#
# VLM_CACHE_TTL_S — frame yang secara persepsi identik tidak ditanyakan ulang.
# Selama satu pemindaian anak memegang benda yang sama, jadi ini yang membuat
# satu sortiran berbiaya SATU panggilan, bukan tiga. Kira-kira sepanjang
# SCAN_TIMEOUT_MS kiosk (15 dtk). 0 mematikan cache.
VLM_CACHE_TTL_S=15
