# Reverse proxy produksi Binexa — TEMPLATE, bukan config final.
#
# Image nginx resmi menjalankan envsubst atas /etc/nginx/templates/*.template
# saat start. NGINX_ENVSUBST_FILTER dibatasi ke ADMIN_HOST/KIOSK_HOST supaya
# variabel nginx sendiri ($host, $uri, $remote_addr) TIDAK ikut disubstitusi —
# tanpa filter itu semuanya berubah jadi string kosong dan proxy-nya rusak.
#
# Dua frontend dibedakan lewat HOST, bukan path: keduanya SPA yang mengklaim
# root-nya sendiri, dan menempatkan salah satunya di sub-path akan memaksa
# konfigurasi base URL Vite yang berbeda per deployment.

upstream php { server backend:9000; }

# --- Dashboard admin ---
server {
    listen 80 default_server;
    server_name ${ADMIN_HOST} _;

    location / {
        proxy_pass http://admin:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api    { include /etc/nginx/conf.d/php.inc; }
    location /sanctum { include /etc/nginx/conf.d/php.inc; }
    location /up     { include /etc/nginx/conf.d/php.inc; }
}

# --- Kiosk ---
server {
    listen 80;
    server_name ${KIOSK_HOST};

    location / {
        proxy_pass http://kiosk:80;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api { include /etc/nginx/conf.d/php.inc; }
    location /up  { include /etc/nginx/conf.d/php.inc; }
}
