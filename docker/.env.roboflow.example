# Templat env untuk CV mode roboflow (Roboflow Cloud API).
# Salin file ini menjadi docker/.env.roboflow (gitignored) lalu isi API key asli.
#   cp docker/.env.roboflow.example docker/.env.roboflow
# docker-compose memuatnya otomatis via `env_file` pada service cv-service.
CV_MODE=roboflow
CV_MODEL_PATH=/model/best.pt
ROBOFLOW_MODEL_ID=deteksi-sampah-organik-anorganik/3
ROBOFLOW_API_KEY=isi-api-key-roboflow-anda
