# Kiosk Binexa — konfigurasi perangkat.
#
# TOKEN DAN UNIT_CODE TIDAK ADA DI SINI lagi (dan jangan ditambahkan kembali).
# Semua variabel VITE_* di-inline ke dalam bundle .js saat build, jadi token yang
# lewat berkas ini akan terbaca siapa pun yang membuka DevTools di tablet kiosk.
#
# Kiosk kini mengambil tokennya sendiri saat aktivasi:
#   1. admin  : php artisan unit:activation-code BNX-001
#   2. kiosk  : buka kiosk, masukkan kodenya di layar aktivasi
#   3. token + unit_code tersimpan di localStorage perangkat itu saja

VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000/api

# Jeda relay pembacaan ESP32 -> cloud (ms). Layar tetap refresh tiap 2 detik.
VITE_FILL_RELAY_MS=30000

# ESP32 lokal — HOST saja, tanpa /api.
VITE_ESP32_BASE_URL=bunnybin.local

# ---------------------------------------------------------------------------
# KAMERA — kiosk memindai dengan kamera HP, bukan kamera bawaan laptop.
# ---------------------------------------------------------------------------
# auto   : coba kamera virtual dulu, jatuh ke stream MJPEG bila tak ada
# device : HANYA kamera virtual (droidcam-cli + v4l2loopback di host)
# mjpeg  : HANYA stream HTTP dari app di HP, lewat proxy kiosk
VITE_CAMERA_SOURCE=auto

# Pola label kamera virtual, dipisah koma, urut prioritas.
# Kosongkan (baris tanpa nilai) untuk memakai kamera default host apa adanya.
VITE_CAMERA_DEVICE_MATCH=droidcam,iriun,ivcam,epoccam,ip webcam,v4l2 loopback,dummy video

# Boleh jatuh ke kamera bawaan laptop bila kamera HP tak ditemukan?
# false = kiosk menolak memindai daripada memindai dengan kamera yang salah.
VITE_CAMERA_ALLOW_BUILTIN_FALLBACK=true

# Alamat app kamera di HP — TARGET PROXY, bukan yang dibuka browser.
# DroidCam menampilkannya di layar app saat dijalankan.
VITE_CAMERA_STREAM_URL=http://10.23.3.187:4747

# Path feed DI HP. Browser tidak membukanya langsung — kiosk selalu meminta
# lewat /camera-proxy supaya same-origin (canvas tidak ternoda).
#   DroidCam  : /mjpegfeed?640x480
#   IP Webcam : /video
VITE_CAMERA_STREAM_PATH=/mjpegfeed?640x480

# Batas tunggu frame pertama (ms).
VITE_CAMERA_READY_TIMEOUT_MS=8000

# Debug Panel — jangan pernah true di build produksi.
VITE_DEBUG_PANEL=true
