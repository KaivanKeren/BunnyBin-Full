# Kiosk Binexa — TEMPLATE, bukan config final.
#
# Image nginx resmi menjalankan envsubst atas /etc/nginx/templates/*.template
# saat container start. NGINX_ENVSUBST_FILTER dibatasi ke CAMERA_STREAM_URL
# supaya variabel nginx sendiri ($uri, $host) TIDAK ikut disubstitusi — tanpa
# filter itu semuanya jadi string kosong dan config-nya rusak.
#
# Alasan file ini jadi template: alamat HP yang menyajikan kamera berbeda di
# tiap sekolah dan bisa berubah tiap kali DHCP membagi ulang. Kalau ia di-inline
# saat build, mengganti HP berarti build ulang image.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA: seluruh path non-berkas dikembalikan ke index.html supaya refresh di
    # /units/1 tidak menghasilkan 404 dari nginx.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Stream kamera HP (DroidCam/IP Webcam), disajikan sebagai path kiosk
    # sendiri. Ini bukan sekadar kemudahan: kiosk menggambar frame ke <canvas>
    # lalu memanggil toDataURL(), dan gambar lintas-origin tanpa header CORS —
    # yang tidak pernah dikirim DroidCam — menodai canvas sehingga panggilan itu
    # melempar SecurityError. Lewat proxy ini, feed HP satu origin dengan kiosk.
    location /camera-proxy/ {
        proxy_pass ${CAMERA_STREAM_URL}/;

        # Respons multipart/x-mixed-replace memang TIDAK pernah selesai.
        # Buffering akan menahannya di memori tanpa pernah meneruskan satu frame
        # pun, dan read timeout bawaan (60 dtk) memutus kamera di tengah jam
        # sekolah. Keduanya harus dimatikan.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Aset ber-hash dari Vite aman di-cache lama; index.html tidak boleh,
    # karena ia yang menunjuk ke nama berkas hash terbaru.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
